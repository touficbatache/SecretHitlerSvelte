{
  "rules": {
    "ongoingGames": {
      "$gameCode": {
        ".read": "data.child('connected').child(auth.uid).exists()",
        ".write": false,
        "connected": {
          "$userId": {
            ".write": "$userId === auth.uid && data.exists() && newData.isBoolean()"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "settings": {
          "streamerMode": {
            ".validate": "newData.isBoolean()"
          },
          "skipLongIntro": {
            ".validate": "newData.isBoolean()"
          },
          "hidePicsGameInfo": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
