# API url
PUBLIC_API_URL="https://YOUR-FIREBASE-PROJECT/api/"

# Dev mode activates the Firebase AppCheck debug token
PUBLIC_DEBUG=false

# Use the local Firebase emulators (auth on 127.0.0.1:9099, database on 127.0.0.1:9000)
# instead of the project's services. Used by the end-to-end tests.
PUBLIC_USE_EMULATORS=false

# Firebase project's public JSON config
PUBLIC_FIREBASE_CONFIG="FIREBASE PROJECT'S PUBLIC CONFIG"

# Project's recaptcha enterprise key
PUBLIC_RECAPTCHA_SITE_KEY="RECAPTCHA ENTERPRISE SITE KEY"

# Are we using the HTTPS protocol?
PUBLIC_SECURE=true

# Firebase project's private, server-side config, used for auth and game data fetching
PRIVATE_FIREBASE_SERVER_CONFIG="FIREBASE PROJECT'S PRIVATE SERVER-SIDE CONFIG"
